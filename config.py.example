"""
config.py.example
--------------------
Ye sirf ek TEMPLATE hai — real secrets is file mein NAHI likhne.

Kya karna hai:
    1. Is file ki copy banayein aur naam `config.py` rakhein:
           cp config.py.example config.py
    2. `config.py` mein apni asli values bharein.
    3. `config.py` ko kabhi commit na karein — `.gitignore` mein
       already add hai, lekin double-check zaroor kar lein.

Streamlit Cloud pe deploy karte waqt, ye values yahan nahi — "Secrets"
settings (Settings > Secrets) mein daalni hain, isi naam se.
"""

# --- Zaroori (required) ---
GEMINI_API_KEY = "your-gemini-api-key-here"       # https://aistudio.google.com/apikey se milti hai
CLASS_PIN = "1234"                                 # students isse app open karne ke liye use karenge
TEACHER_PASSWORD = "change-me-to-something-strong"  # sirf dashboard.py ke liye

# --- Optional: quota-scaling (2-3 keys tak rotate kar sakte hain) ---
# Gemini ka quota PROJECT-level hota hai, KEY-level nahi — matlab alag
# Google accounts se banayi gayi keys ki alag-alag quota pools hoti hain.
# Yahan 2-3 keys (alag accounts se) de dein to app khud rotate karega:
# ek key ka quota khatam ho to agli try hoti hai, students ko kuch nazar
# nahi aata. Chhod dein khaali agar sirf 1 key chahiye (default, pehle
# jaisa behavior).
GEMINI_API_KEY_2 = None
GEMINI_API_KEY_3 = None

# --- Optional: embedding provider ---
# "gemini" (default) ya "local" (free, apne machine par chalta hai, koi
# API key/quota nahi chahiye — dekhein embedding_backend.py aur README.md
# ka "Zero-budget setup" section). Agar "local" karein to
# `pip install -r requirements-local-embeddings.txt` bhi chalayein, aur
# `python3 embed_chunks.py --rebuild` se knowledge base dobara banayein.
EMBEDDING_PROVIDER = "gemini"

# --- Optional: generation fallback provider ---
# Agar Gemini free-tier quota exam-week mein khatam ho jaye, to yahan ek
# fallback provider set kar sakte hain (jaise AgentRouter — agentrouter.org
# — ya OpenRouter, Groq, waghera). Chhod dein `None` par agar fallback
# nahi chahiye (default behaviour, Gemini failure seedha error dega jaisa
# pehle hota tha).
#
# GENERATION_FALLBACK_PROVIDER = "agentrouter"
# GENERATION_FALLBACK_API_KEY = "sk-..."            # apni AgentRouter key (kabhi commit na karein!)
# GENERATION_FALLBACK_MODEL = "claude-sonnet-4-5-20250929"  # apne console mein available model dekhein
GENERATION_FALLBACK_PROVIDER = None
GENERATION_FALLBACK_API_KEY = None
GENERATION_FALLBACK_MODEL = None

# --- Optional: shared storage (Turso) ---
# Agar teacher dashboard aur student app ALAG Streamlit Cloud apps ke
# tor par deploy kiye hain (do alag URLs), to local storage ek doosre
# ko kabhi nazar nahi aati — dashboard hamesha khali dikhega. Turso
# (free hosted SQLite-compatible DB) ye fix karta hai. Setup steps
# db_connection.py ke docstring mein hain. In DONO apps ki secrets mein
# SAME values honi chahiye:
#
# TURSO_DATABASE_URL = "libsql://your-db-name.turso.io"
# TURSO_AUTH_TOKEN = "..."
TURSO_DATABASE_URL = None
TURSO_AUTH_TOKEN = None
